            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{core_url}}/classes/teaching",
              "host": ["{{core_url}}"],
              "path": ["classes", "teaching"]
            },
            "description": "Lấy danh sách các lớp học do giáo viên hiện tại đứng lớp."
          },
          "response": []
        },
        {
