    {
      "name": "03. Core API - Class Management (LMS-05 - Nguyễn Anh Tú)",
      "item": [
        {
          "name": "1. Create Class (Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.class) {",
                  "    if (jsonData.class._id) pm.environment.set(\"class_id\", jsonData.class._id);",
                  "    if (jsonData.class.code) pm.environment.set(\"class_code\", jsonData.class.code);",
                  "    console.log(\"Class ID:\", jsonData.class._id, \"Class Code:\", jsonData.class.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{teacher_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lập trình Di động MMA301\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{core_url}}/classes",
              "host": ["{{core_url}}"],
              "path": ["classes"]
            },
            "description": "Teacher tạo lớp học mới. Hệ thống sinh mã code 6 ký tự ngẫu nhiên. Tự động lưu `class_id` và `class_code` vào Environment."
          },
          "response": []
        },
        {
          "name": "2. Get Teaching Classes (Teacher)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
