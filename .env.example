# Copy thành .env ở thư mục gốc rồi chỉnh nếu cần.
# Không commit .env. Không dán API key / secret production vào đây.

NODE_ENV=development
JWT_SECRET=change-me-in-local-dev-min-32-chars!!
JWT_EXPIRES_IN=7d

MONGO_ROOT_USER=lms
MONGO_ROOT_PASSWORD=lms_dev_password
MONGO_HOST=127.0.0.1
MONGO_PORT=27018

AUTH_MONGO_URI=mongodb://lms:lms_dev_password@127.0.0.1:27018/lms_auth?authSource=admin
CORE_MONGO_URI=mongodb://lms:lms_dev_password@127.0.0.1:27018/lms_core?authSource=admin

AUTH_PORT=4001
CORE_PORT=4002

TRUST_PROXY=false
CORS_ORIGIN=*
JSON_BODY_LIMIT=10mb

# Seed (auth-service)
SEED_TEACHER_EMAIL=teacher@lms.local
SEED_STUDENT_EMAIL=student@lms.local
SEED_PASSWORD=Demo123!

# Mobile (Expo) — máy ảo Android + API trên host
EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:4001
EXPO_PUBLIC_CORE_URL=http://10.0.2.2:4002

# SePay (mở khóa tài nguyên). Để trống = demo confirm; có đủ 3 key = LIVE hosted QR.
# PUBLIC_CORE_URL: device-reachable hosted-launch (Android emulator → http://10.0.2.2:4002).
# SEPAY_RETURN_BASE_URL: optional public/tunnel base for signed success/error/cancel (else PUBLIC_CORE_URL).
# Dashboard IPN URL (staging): https://mma301-lms-core-staging.onrender.com/payments/sepay/ipn
# SePay POSTs application/json with header X-Secret-Key = SEPAY_SECRET_KEY (Auth = Secret Key).
PUBLIC_CORE_URL=http://10.0.2.2:4002
# SEPAY_RETURN_BASE_URL=
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
# SEPAY_BANK_CODE=MBBank
# SEPAY_BANK_ACCOUNT=
# SEPAY_BANK_NAME=

# Firebase — để trống đến khi tạo project trên Console.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
